{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/onboarding/ingestion-work-item-v1.json",
  "title": "OUF Ingestion Work Item v1",
  "description": "Lease-based handoff from Source Onboarding to Ingestion Runtime.",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "ingestion_id", "asset_id", "profile_id", "source_id", "onboarding_version_id", "state", "attempts", "max_attempts", "lease_until"],
      "properties": {
        "kind": {"const": "INITIAL_MANAGED_FILE"},
        "ingestion_id": {"type": "string", "format": "uuid"},
        "asset_id": {"type": "string", "format": "uuid"},
        "profile_id": {"type": "string", "format": "uuid"},
        "source_id": {"type": "string"},
        "onboarding_version_id": {"type": "string", "format": "uuid"},
        "state": {"enum": ["RUNNING"]},
        "attempts": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "lease_until": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["kind", "dispatch_id", "schedule_id", "source_id", "onboarding_version_id", "due_at", "state", "attempts", "lease_until"],
      "properties": {
        "kind": {"const": "SCHEDULED_PULL"},
        "dispatch_id": {"type": "string", "format": "uuid"},
        "schedule_id": {"type": "string", "format": "uuid"},
        "source_id": {"type": "string"},
        "onboarding_version_id": {"type": "string", "format": "uuid"},
        "due_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["RUNNING"]},
        "attempts": {"type": "integer", "minimum": 1},
        "lease_until": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    }
  ],
  "x-ouf-lifecycle": {
    "claim": "READY or RETRY_WAIT -> RUNNING; expired RUNNING leases may be reclaimed while attempts remain",
    "heartbeat": "Only the current worker may extend an unexpired lease",
    "complete": "RUNNING -> SUCCEEDED and idempotent for the same output reference",
    "fail": "RUNNING -> retry state, then terminal FAILED or QUARANTINED when attempts are exhausted"
  },
  "x-ouf-ownership": {
    "Source Onboarding": "schedule, work-item state, lease arbitration and activation gate",
    "Ingestion Runtime": "acquisition execution, heartbeat and terminal result reporting"
  }
}
