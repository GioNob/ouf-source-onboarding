{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ouf:managed-file-execution-proposal:lexical-csv:v1",
  "description": "Preparation only. CSV cells stay lexical strings; property/access/source/tenant and exact semantic-reference consistency are checked against owner records. No approval, publication, compatibility attestation or runtime authority is issued.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semanticBindings",
    "semanticPublicationSetRef",
    "udp",
    "limits"
  ],
  "properties": {
    "semanticBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semanticId",
          "semanticVersion",
          "revisionId",
          "publicationSetId"
        ],
        "properties": {
          "semanticId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^@\\s]+$"
          },
          "semanticVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^@\\s]+$"
          },
          "revisionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "publicationSetId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "semanticPublicationSetRef": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "udp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "materialization"
      ],
      "properties": {
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategyId",
            "strategyVersion",
            "policyRef",
            "governedIdentity"
          ],
          "properties": {
            "strategyId": {
              "const": "GOVERNED_IDENTITY"
            },
            "strategyVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "policyRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "governedIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "version",
                "tenantId",
                "canonicalClass",
                "sourceId",
                "maxCandidates",
                "allowAutoNew",
                "signals",
                "sufficientRules"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "tenantId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "canonicalClass": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "maxCandidates": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "allowAutoNew": {
                  "type": "boolean"
                },
                "signals": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "semanticRef",
                      "comparator",
                      "excludesOnDisagreement",
                      "uniqueWithinScope",
                      "assertionRef"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      },
                      "semanticRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      },
                      "comparator": {
                        "type": "string",
                        "enum": [
                          "CONCEPT",
                          "TEXT_V1",
                          "DECIMAL_V1",
                          "JSON_V1"
                        ]
                      },
                      "excludesOnDisagreement": {
                        "const": false
                      },
                      "uniqueWithinScope": {
                        "const": false
                      },
                      "assertionRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    }
                  }
                },
                "sufficientRules": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "signalIds",
                      "assertionRef"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      },
                      "signalIds": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "uniqueItems": true
                      },
                      "assertionRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyRef",
            "properties",
            "bitemporalProperties",
            "checkpointInterval"
          ],
          "properties": {
            "policyRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "properties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sourceField",
                  "propertyIri",
                  "datatype",
                  "accessLabel",
                  "authorityOrder"
                ],
                "properties": {
                  "sourceField": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "propertyIri": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "datatype": {
                    "const": "http://www.w3.org/2001/XMLSchema#string"
                  },
                  "accessLabel": {
                    "type": "string",
                    "enum": [
                      "OPEN",
                      "ANONYMOUS",
                      "PERSONAL",
                      "SENSITIVE",
                      "RESTRICTED"
                    ]
                  },
                  "authorityOrder": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "uniqueItems": true
                  }
                }
              }
            },
            "bitemporalProperties": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "checkpointInterval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRows",
        "maxColumns",
        "maxCellChars"
      ],
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxCellChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  }
}
